# =============================================================================
# Denali Local Development Environment — Template
# =============================================================================
# Copy this to .env.local and fill in your values.
#
# NOTE: Supabase, Vercel, and MCP server references were removed 2026-04-07.
# Denali runs on AWS (RDS + Cognito + ECS/Fargate + Bedrock + SES).
# Production secrets are managed via AWS Secrets Manager, not env files.
# See CLAUDE.md "Environment Variables" for the full production list.
# =============================================================================

# Claude API (local dev only — ECS uses Bedrock via IAM auth, no API key needed)
ANTHROPIC_API_KEY=sk-ant-your-api-key
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_APPEAL_MODEL=claude-opus-4-6

# Database (AWS RDS PostgreSQL — local dev connects directly, ECS uses Secrets Manager)
DATABASE_URL=postgresql://user:password@your-rds-host:5432/dbname

# AWS Cognito (auth)
COGNITO_USER_POOL_ID=us-east-1_your-pool-id
COGNITO_CLIENT_ID=your-client-id
COGNITO_CLIENT_SECRET=your-client-secret
AWS_REGION=us-east-1

# AWS SES (email)
SES_FROM_EMAIL=no-reply@denali.health

# Blue Button 2.0 (CMS FHIR API — sandbox for dev)
BLUEBUTTON_CLIENT_ID=your-bluebutton-client-id
BLUEBUTTON_CLIENT_SECRET=your-bluebutton-client-secret
BLUEBUTTON_BASE_URL=https://sandbox.bluebutton.cms.gov
FHIR_TOKEN_ENCRYPTION_KEY=your-64-char-hex-key-for-aes-256-gcm

# Stripe (optional for local dev — sandbox keys)
# STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# ID.me (optional — identity verification for Medicare App Library mode)
# IDME_CLIENT_ID=your-idme-client-id
# IDME_CLIENT_SECRET=your-idme-client-secret
# IDME_BASE_URL=https://api.idmelabs.com
# REQUIRE_IDENTITY_VERIFICATION=false
