{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Denali infrastructure monitor \u2014 twice-daily health + cost digest via SNS (SMS + email)",
  "Resources": {
    "MonitorTopic": {
      "Type": "AWS::SNS::Topic",
      "Properties": {
        "TopicName": "denali-monitor-alerts",
        "Tags": [
          {
            "Key": "Project",
            "Value": "Denali"
          }
        ]
      }
    },
    "EmailSub1": {
      "Type": "AWS::SNS::Subscription",
      "Properties": {
        "TopicArn": {
          "Ref": "MonitorTopic"
        },
        "Protocol": "email",
        "Endpoint": "ramanac@gmail.com"
      }
    },
    "EmailSub2": {
      "Type": "AWS::SNS::Subscription",
      "Properties": {
        "TopicArn": {
          "Ref": "MonitorTopic"
        },
        "Protocol": "email",
        "Endpoint": "admin@denali.health"
      }
    },
    "MonitorRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "denali-monitor-lambda-role",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "denali-monitor-permissions",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecs:DescribeServices",
                    "ecs:DescribeClusters"
                  ],
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "aws:ResourceTag/Project": "Denali"
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecs:DescribeServices"
                  ],
                  "Resource": "arn:aws:ecs:us-east-1:236823123138:service/denali/denali-web"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "rds:DescribeDBInstances"
                  ],
                  "Resource": "arn:aws:rds:us-east-1:236823123138:db:denali-prod"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "elasticloadbalancing:DescribeTargetHealth",
                    "elasticloadbalancing:DescribeTargetGroups"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "budgets:ViewBudget"
                  ],
                  "Resource": "arn:aws:budgets::236823123138:budget/*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "cloudwatch:GetMetricStatistics",
                    "cloudwatch:DescribeAlarms"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "sns:Publish"
                  ],
                  "Resource": {
                    "Ref": "MonitorTopic"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogGroup",
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": "arn:aws:logs:us-east-1:236823123138:*"
                }
              ]
            }
          }
        ]
      }
    },
    "MonitorFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": "denali-monitor",
        "Runtime": "python3.12",
        "Handler": "index.handler",
        "Role": {
          "Fn::GetAtt": [
            "MonitorRole",
            "Arn"
          ]
        },
        "Timeout": 30,
        "MemorySize": 128,
        "Environment": {
          "Variables": {
            "SNS_TOPIC_ARN": {
              "Ref": "MonitorTopic"
            },
            "ECS_CLUSTER": "denali",
            "ECS_SERVICE": "denali-web",
            "RDS_INSTANCE": "denali-prod",
            "ALB_TG_NAME": "denali-tg"
          }
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "Denali"
          }
        ],
        "Code": {
          "ZipFile": {
            "Fn::Join": [
              "\n",
              [
                "import boto3, os, json",
                "from datetime import datetime, timedelta, timezone",
                "",
                "ecs = boto3.client('ecs')",
                "rds = boto3.client('rds')",
                "elbv2 = boto3.client('elbv2')",
                "budgets = boto3.client('budgets')",
                "sns = boto3.client('sns')",
                "cw = boto3.client('cloudwatch')",
                "",
                "def handler(event, context):",
                "    alerts = []",
                "    status_lines = []",
                "    now = datetime.now(timezone.utc)",
                "    ct_hour = (now - timedelta(hours=6)).strftime('%I:%M %p CT')",
                "",
                "    # --- ECS ---",
                "    try:",
                "        r = ecs.describe_services(cluster=os.environ['ECS_CLUSTER'], services=[os.environ['ECS_SERVICE']])",
                "        svc = r['services'][0]",
                "        desired = svc['desiredCount']",
                "        running = svc['runningCount']",
                "        if desired != running:",
                "            alerts.append(f'ECS: desired={desired} but running={running}')",
                "            status_lines.append(f'\\u26a0\\ufe0f ECS: desired={desired} running={running}')",
                "        else:",
                "            status_lines.append(f'\\u2705 ECS: desired={desired} running={running}')",
                "    except Exception as e:",
                "        alerts.append(f'ECS check failed: {e}')",
                "        status_lines.append(f'\\u274c ECS: check failed')",
                "",
                "    # --- RDS ---",
                "    try:",
                "        r = rds.describe_db_instances(DBInstanceIdentifier=os.environ['RDS_INSTANCE'])",
                "        db = r['DBInstances'][0]",
                "        db_status = db['DBInstanceStatus']",
                "        db_public = db.get('PubliclyAccessible', False)",
                "        if db_public:",
                "            alerts.append('RDS: PubliclyAccessible is TRUE')",
                "        # Unexpected states",
                "        expected = ['available', 'stopped', 'starting', 'stopping']",
                "        if db_status not in expected:",
                "            alerts.append(f'RDS: unexpected status \"{db_status}\"')",
                "            status_lines.append(f'\\u26a0\\ufe0f RDS: {db_status}')",
                "        else:",
                "            status_lines.append(f'\\u2705 RDS: {db_status}')",
                "    except Exception as e:",
                "        alerts.append(f'RDS check failed: {e}')",
                "        status_lines.append(f'\\u274c RDS: check failed')",
                "",
                "    # --- ALB Target Health ---",
                "    try:",
                "        tgs = elbv2.describe_target_groups(Names=[os.environ['ALB_TG_NAME']])",
                "        tg_arn = tgs['TargetGroups'][0]['TargetGroupArn']",
                "        health = elbv2.describe_target_health(TargetGroupArn=tg_arn)",
                "        targets = health['TargetHealthDescriptions']",
                "        healthy = sum(1 for t in targets if t['TargetHealth']['State'] == 'healthy')",
                "        total = len(targets)",
                "        if total == 0:",
                "            status_lines.append(f'\\u23f8\\ufe0f ALB: no targets (infra likely stopped)')",
                "        elif healthy < total:",
                "            alerts.append(f'ALB: {healthy}/{total} healthy')",
                "            status_lines.append(f'\\u26a0\\ufe0f ALB: {healthy}/{total} healthy')",
                "        else:",
                "            status_lines.append(f'\\u2705 ALB: {healthy}/{total} healthy')",
                "    except Exception as e:",
                "        status_lines.append(f'\\u2705 ALB: target check skipped')",
                "",
                "    # --- Costs (MTD + forecast via free Budgets API; CE polling removed 2026-06-10) ---",
                "    try:",
                "        account_id = context.invoked_function_arn.split(':')[4]",
                "        all_budgets = budgets.describe_budgets(AccountId=account_id)['Budgets']",
                "        target = next((b for b in all_budgets if b['BudgetName'] == 'denali-monthly' and 'CalculatedSpend' in b), None)",
                "        if target is None:",
                "            target = next((b for b in all_budgets if 'CalculatedSpend' in b), None)",
                "        if target is None:",
                "            raise RuntimeError('no budget with CalculatedSpend')",
                "        mtd_cost = float(target['CalculatedSpend']['ActualSpend']['Amount'])",
                "        fc = target['CalculatedSpend'].get('ForecastedSpend')",
                "        forecast = float(fc['Amount']) if fc else None",
                "        forecast_line = f'${forecast:.2f}' if forecast else 'N/A'",
                "",
                "        status_lines.append(f'\\U0001f4b0 Costs: MTD ${mtd_cost:.2f} | Forecast {forecast_line} (budget {target[\"BudgetName\"]})')",
                "",
                "        # Pro-rata pace alert replaces the old yesterday>$3 CE check",
                "        # (Budgets has no daily granularity; ActualSpend is cumulative MTD)",
                "        if mtd_cost > 3.0 * now.day:",
                "            alerts.append(f'Cost pace high: MTD ${mtd_cost:.2f} > $3/day x {now.day} days')",
                "        if forecast and forecast > 60:",
                "            alerts.append(f'Forecast ${forecast:.2f} exceeds $60/mo budget')",
                "",
                "    except Exception as e:",
                "        status_lines.append(f'\\U0001f4b0 Costs: check failed ({e})')",
                "",
                "    # --- Build message ---",
                "    if alerts:",
                "        subject = f'\\u26a0\\ufe0f Denali Alert \u2014 {len(alerts)} issue(s)'",
                "        header = f'DENALI INFRA ALERT \u2014 {ct_hour}\\n{\"=\" * 35}\\n'",
                "        alert_block = '\\n'.join(f'  \\u26a0\\ufe0f {a}' for a in alerts)",
                "        body = header + '\\nISSUES:\\n' + alert_block + '\\n\\nSTATUS:\\n' + '\\n'.join(f'  {s}' for s in status_lines)",
                "    else:",
                "        subject = f'\\u2705 Denali OK \u2014 {ct_hour}'",
                "        body = f'DENALI STATUS \u2014 {ct_hour}\\n{\"=\" * 35}\\n\\n' + '\\n'.join(f'  {s}' for s in status_lines)",
                "",
                "    body += '\\n\\n---\\ndenali.health infra monitor'",
                "",
                "    # --- Send ---",
                "    sns.publish(",
                "        TopicArn=os.environ['SNS_TOPIC_ARN'],",
                "        Subject=subject[:100],",
                "        Message=body",
                "    )",
                "",
                "    print(f'Sent: {subject}')",
                "    print(body)",
                "    return {'statusCode': 200, 'alerts': len(alerts)}"
              ]
            ]
          }
        }
      }
    },
    "MorningRule": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "Name": "denali-monitor-morning",
        "Description": "9:30 AM CT daily health + cost check (30 min after weekday 8:55 startup; weekends report stopped state)",
        "ScheduleExpression": "cron(30 14 * * ? *)",
        "State": "ENABLED",
        "Targets": [
          {
            "Arn": {
              "Fn::GetAtt": [
                "MonitorFunction",
                "Arn"
              ]
            },
            "Id": "morning-check"
          }
        ]
      }
    },
    "EveningRule": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "Name": "denali-monitor-evening",
        "Description": "8:00 PM CT daily health + cost check",
        "ScheduleExpression": "cron(0 2 * * ? *)",
        "State": "ENABLED",
        "Targets": [
          {
            "Arn": {
              "Fn::GetAtt": [
                "MonitorFunction",
                "Arn"
              ]
            },
            "Id": "evening-check"
          }
        ]
      }
    },
    "MorningPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "MonitorFunction"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "events.amazonaws.com",
        "SourceArn": {
          "Fn::GetAtt": [
            "MorningRule",
            "Arn"
          ]
        }
      }
    },
    "EveningPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "MonitorFunction"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "events.amazonaws.com",
        "SourceArn": {
          "Fn::GetAtt": [
            "EveningRule",
            "Arn"
          ]
        }
      }
    }
  },
  "Outputs": {
    "TopicArn": {
      "Value": {
        "Ref": "MonitorTopic"
      },
      "Description": "SNS topic ARN for alerts"
    },
    "MonitorFunctionArn": {
      "Value": {
        "Fn::GetAtt": [
          "MonitorFunction",
          "Arn"
        ]
      },
      "Description": "Monitor Lambda ARN"
    }
  }
}
